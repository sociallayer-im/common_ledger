<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="lg:flex lg:items-center lg:justify-between">
    <div class="min-w-0 flex-1">
      <nav class="flex" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <div class="flex">
              <.link
                href={~p"/groups"}
                class="text-sm font-medium text-gray-500 hover:text-gray-700"
              >
                Groups
              </.link>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg
                class="h-5 w-5 flex-shrink-0 text-gray-400"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="ml-4 text-sm font-medium text-gray-500"><%= @group.name %></span>
            </div>
          </li>
        </ol>
      </nav>
      <h2 class="mt-4 text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
        <%= @group.name %>
      </h2>
      <div class="mt-1 flex flex-col sm:mt-0 sm:flex-row sm:flex-wrap sm:space-x-6">
        <div class="mt-2 flex items-center text-sm text-gray-500">
          <svg
            class="mr-1.5 h-5 w-5 flex-shrink-0 text-gray-400"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z"
              clip-rule="evenodd"
            />
          </svg>
          <%= length(@group.members) %> members
        </div>
        <div class="mt-2 flex items-center text-sm text-gray-500">
          <svg
            class="mr-1.5 h-5 w-5 flex-shrink-0 text-gray-400"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
          </svg>
          <%= length(@group.projects) %> projects
        </div>
      </div>
    </div>
    <div class="mt-5 flex lg:ml-4 lg:mt-0">
      <span class="hidden sm:block">
        <.link
          href={~p"/groups/#{@group}/edit"}
          class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
        >
          <svg
            class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z" />
            <path
              fill-rule="evenodd"
              d="M2 6a2 2 0 012-2h4a1 1 0 010 2h-4a1 1 0 010-2h4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"
              clip-rule="evenodd"
            />
          </svg>
          Edit
        </.link>
      </span>

      <span class="ml-3 hidden sm:block">
        <.link
          href={~p"/groups/#{@group}/add_member"}
          class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
        >
          <svg
            class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z" />
          </svg>
          Add Member
        </.link>
      </span>

      <span class="sm:ml-3">
        <.link
          href={~p"/groups/#{@group}/projects/new"}
          class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
        >
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path
              fill-rule="evenodd"
              d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"
              clip-rule="evenodd"
            />
          </svg>
          New Project
        </.link>
      </span>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-base font-semibold leading-6 text-gray-900">Description</h3>
        <div class="mt-2 max-w-xl text-sm text-gray-500">
          <p><%= @group.description || "No description provided" %></p>
        </div>
      </div>
    </div>

    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-semibold leading-6 text-gray-900">Projects</h3>
        </div>
        <div class="mt-4 divide-y divide-gray-200">
          <%= for project <- @group.projects do %>
            <.link href={~p"/projects/#{project}"} class="block hover:bg-gray-50">
              <div class="flex items-center justify-between py-4">
                <div class="flex items-center">
                  <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-indigo-100">
                    <span class="text-sm font-medium leading-none text-indigo-700">
                      <%= String.slice(project.name, 0, 2) |> String.upcase() %>
                    </span>
                  </span>
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900"><%= project.name %></p>
                    <p class="text-sm text-gray-500"><%= length(project.members || []) %> members</p>
                  </div>
                </div>
                <div class="flex items-center space-x-4">
                  <.link
                    href={~p"/projects/#{project}/edit"}
                    class="text-sm font-medium text-indigo-600 hover:text-indigo-500"
                  >
                    Edit
                  </.link>
                  <form action={~p"/projects/#{project}"} method="post" class="inline">
                    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                    <input type="hidden" name="_method" value="delete" />
                    <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-500">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </.link>
          <% end %>

          <%= if Enum.empty?(@group.projects) do %>
            <div class="py-4 text-sm text-gray-500 text-center">
              No projects yet
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-base font-semibold leading-6 text-gray-900">Members</h3>
        <div class="mt-4 divide-y divide-gray-200">
          <%= for member <- @group.members do %>
            <div class="flex items-center justify-between py-4">
              <div class="flex items-center">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-gray-500">
                  <span class="text-sm font-medium leading-none text-white">
                    <%= String.slice(member.email, 0, 2) |> String.upcase() %>
                  </span>
                </span>
                <div class="ml-3">
                  <p class="text-sm font-medium text-gray-900">
                    <%= member.name || "Unnamed User" %>
                  </p>
                  <p class="text-sm text-gray-500"><%= member.email %></p>
                </div>
              </div>
              <form
                action={~p"/groups/#{@group}/members/#{member.id}"}
                method="post"
                class="inline"
              >
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-500">
                  Remove
                </button>
              </form>
            </div>
          <% end %>

          <%= if Enum.empty?(@group.members) do %>
            <div class="py-4 text-sm text-gray-500 text-center">
              No members yet
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
