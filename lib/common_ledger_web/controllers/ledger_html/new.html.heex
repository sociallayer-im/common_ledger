<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold leading-tight text-gray-900">New Ledger</h1>
      <p class="mt-2 text-sm text-gray-600">Create a new ledger in <%= @project.name %></p>
    </div>
  </div>

  <div class="mt-8">
    <.ledger_form changeset={@changeset} action={~p"/projects/#{@project.id}/ledgers"} />
  </div>
</div>