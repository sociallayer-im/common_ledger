<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold leading-tight text-gray-900">Edit Ledger</h1>
      <p class="mt-2 text-sm text-gray-600">Edit ledger in <%= @project.name %></p>
    </div>
  </div>

  <div class="mt-8">
    <.simple_form :let={f} for={@changeset} method="put" action={~p"/ledgers/#{@ledger.id}"}>
      <.input field={f[:name]} type="text" label="Name" />
      <.input field={f[:description]} type="textarea" label="Description" />
      <.input
        field={f[:currency_type]}
        type="select"
        label="Currency"
        prompt="Select a currency"
        options={[
          {"US Dollar (USD)", "USD"},
          {"Euro (EUR)", "EUR"},
          {"British Pound (GBP)", "GBP"},
          {"Japanese Yen (JPY)", "JPY"},
          {"Chinese Yuan (CNY)", "CNY"}
        ]}
      />
      <:actions>
        <.button>Update Ledger</.button>
      </:actions>
    </.simple_form>
  </div>
</div>
