<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold leading-tight text-gray-900">Edit Entry</h1>
      <p class="mt-2 text-sm text-gray-600">Edit entry in <%= @ledger.name %></p>
    </div>
  </div>

  <div class="mt-8">
    <.simple_form :let={f} for={@changeset} method="put" action={~p"/entries/#{@entry.id}"}>
      <.input field={f[:amount]} type="number" step="0.01" label="Amount" />
      <.input field={f[:description]} type="textarea" label="Description" />
      <.input
        field={f[:currency]}
        type="select"
        label="Currency"
        prompt="Select a currency"
        options={[
          {"US Dollar (USD)", "USD"},
          {"Euro (EUR)", "EUR"},
          {"British Pound (GBP)", "GBP"},
          {"Japanese Yen (JPY)", "JPY"},
          {"Chinese Yuan (CNY)", "CNY"}
        ]}
      />
      <:actions>
        <.button>Update Entry</.button>
      </:actions>
    </.simple_form>
  </div>
</div>
