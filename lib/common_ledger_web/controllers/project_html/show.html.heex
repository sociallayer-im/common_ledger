<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="lg:flex lg:items-center lg:justify-between">
    <div class="min-w-0 flex-1">
      <nav class="flex" aria-label="Breadcrumb">
        <ol role="list" class="flex items-center space-x-4">
          <li>
            <div class="flex">
              <.link href={~p"/groups"} class="text-sm font-medium text-gray-500 hover:text-gray-700">Groups</.link>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="h-5 w-5 flex-shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              <.link href={~p"/groups/#{@project.group_id}"} class="ml-4 text-sm font-medium text-gray-500 hover:text-gray-700">
                <%= @group.name %>
              </.link>
            </div>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="h-5 w-5 flex-shrink-0 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="ml-4 text-sm font-medium text-gray-500"><%= @project.name %></span>
            </div>
          </li>
        </ol>
      </nav>
      <h2 class="mt-4 text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
        <%= @project.name %>
      </h2>
    </div>
    <div class="mt-5 flex lg:ml-4 lg:mt-0">
      <span class="hidden sm:block">
        <.link
          href={~p"/projects/#{@project}/edit"}
          class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
        >
          <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
            <path d="M17.414 2.586a2 2 0 00-2.828 0L7 10.172V13h2.828l7.586-7.586a2 2 0 000-2.828z" />
            <path fill-rule="evenodd" d="M2 6a2 2 0 012-2h4a1 1 0 010 2h-4a1 1 0 010-2h4v10h10v-4a1 1 0 112 0v4a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" clip-rule="evenodd" />
          </svg>
          Edit
        </.link>
      </span>

      <span class="ml-3">
        <form action={~p"/projects/#{@project}"} method="post" class="inline">
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
          <input type="hidden" name="_method" value="delete" />
          <button
            type="submit"
            class="inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500"
            data-confirm="Are you sure you want to delete this project?"
          >
            <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 10-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            Delete
          </button>
        </form>
      </span>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-base font-semibold leading-6 text-gray-900">Project Details</h3>
        <div class="mt-2 max-w-xl text-sm text-gray-500">
          <p>Created at: <%= Calendar.strftime(@project.inserted_at, "%B %d, %Y") %></p>
        </div>
      </div>
    </div>

    <div class="bg-white shadow sm:rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex justify-between items-center">
          <h3 class="text-base font-semibold leading-6 text-gray-900">Members</h3>
          <.link
            href={~p"/projects/#{@project}/add_member"}
            class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
          >
            Add Member
          </.link>
        </div>
        <div class="mt-4 divide-y divide-gray-200">
          <%= if Enum.empty?(@project.members) do %>
            <div class="py-4 text-sm text-gray-500 text-center">
              No members yet
            </div>
          <% else %>
            <%= for member <- @project.members do %>
              <div class="py-4 flex items-center justify-between">
                <div class="flex items-center">
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900"><%= member.name || member.email %></p>
                    <p class="text-sm text-gray-500"><%= member.email %></p>
                  </div>
                </div>
                <form action={~p"/projects/#{@project}/members/#{member.id}"} method="post" class="inline">
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <input type="hidden" name="_method" value="delete" />
                  <button
                    type="submit"
                    class="text-sm text-red-600 hover:text-red-900"
                    data-confirm="Are you sure you want to remove this member?"
                  >
                    Remove
                  </button>
                </form>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-white shadow sm:rounded-lg lg:col-span-2">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex justify-between items-center">
          <h3 class="text-base font-semibold leading-6 text-gray-900">Accounts</h3>
          <.link
            href={~p"/projects/#{@project}/accounts/new"}
            class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
          >
            Add Account
          </.link>
        </div>
        <div class="mt-4 divide-y divide-gray-200">
          <%= if Enum.empty?(@accounts) do %>
            <div class="py-4 text-sm text-gray-500 text-center">
              No accounts yet
            </div>
          <% else %>
            <%= for account <- @accounts do %>
              <div class="py-4 flex items-center justify-between">
                <div class="flex items-center">
                  <div class="ml-3">
                    <p class="text-sm font-medium text-gray-900">
                      <%= account.name %>
                    </p>
                    <p class="text-sm text-gray-500">
                      Balance: <%= Number.Currency.number_to_currency(account.balance, unit: account.currency_type) %>
                    </p>
                  </div>
                </div>
                <div class="flex items-center space-x-4">
                  <form action={~p"/accounts/#{account.id}"} method="post" class="inline">
                    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                    <input type="hidden" name="_method" value="delete" />
                    <button
                      type="submit"
                      class="text-sm text-red-600 hover:text-red-900"
                      data-confirm="Are you sure you want to delete this account?"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="bg-white shadow sm:rounded-lg lg:col-span-2">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex justify-between items-center">
          <h3 class="text-base font-semibold leading-6 text-gray-900">Ledgers</h3>
          <.link
            href={~p"/projects/#{@project}/ledgers/new"}
            class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
          >
            Add Ledger
          </.link>
        </div>
        <div class="mt-4 divide-y divide-gray-200">
          <%= if Enum.empty?(@ledgers) do %>
            <div class="py-4 text-sm text-gray-500 text-center">
              No ledgers yet
            </div>
          <% else %>
            <%= for ledger <- @ledgers do %>
              <div class="py-4 flex items-center justify-between">
                <div class="flex items-center">
                  <div class="ml-3">
                    <.link href={~p"/ledgers/#{ledger.id}"} class="text-sm font-medium text-gray-900 hover:text-gray-700">
                      <%= ledger.name %>
                    </.link>
                    <p class="text-sm text-gray-500">
                      <%= ledger.description || "No description" %> • <%= ledger.currency_type %>
                    </p>
                  </div>
                </div>
                <div class="flex items-center space-x-4">
                  <form action={~p"/ledgers/#{ledger.id}"} method="post" class="inline">
                    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                    <input type="hidden" name="_method" value="delete" />
                    <button
                      type="submit"
                      class="text-sm text-red-600 hover:text-red-900"
                      data-confirm="Are you sure you want to delete this ledger?"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>