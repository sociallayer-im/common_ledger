<div class="min-h-full">
  <header class="bg-white">
    <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-label="Top">
      <div class="flex w-full items-center justify-between border-b border-zinc-100 py-3">
        <div class="flex items-center">
          <a href="/">
            <span class="sr-only">Common Ledger</span>
            <img class="h-10 w-auto" src={~p"/images/logo.svg"} alt="" />
          </a>
        </div>
        <div class="ml-10 space-x-4">
          <a
            href={~p"/auth/login"}
            class="inline-block rounded-md border border-transparent bg-indigo-500 py-2 px-4 text-base font-medium text-white hover:bg-opacity-75"
          >
            Sign in
          </a>
        </div>
      </div>
    </nav>
  </header>
  <main>
    <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
      <.flash_group flash={@flash} />
      <%= @inner_content %>
    </div>
  </main>
</div>
